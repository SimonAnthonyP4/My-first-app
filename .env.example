# Copy to .env (never commit .env). Values below are placeholders.
#
# Public values: safe to ship in client apps.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Server-only secrets: Edge Function secrets and the admin server environment.
# They must never appear in an iOS bundle or in browser JavaScript.
# Added in later milestones (M3: Stripe, M4: admin server, M8: APNs):
# SUPABASE_SERVICE_ROLE_KEY=
# STRIPE_SECRET_KEY=            # sk_test_... during development
# STRIPE_WEBHOOK_SECRET=        # whsec_...

# Local database used by `make db-test` (plain PostgreSQL, not Supabase).
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
