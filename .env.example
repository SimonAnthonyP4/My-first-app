# Copy to .env (never commit .env). Values below are placeholders.
#
# Public values: safe to ship in client apps.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Server-only secrets. They must never appear in an iOS bundle, in browser
# JavaScript or in git.
#
# Edge Function secrets (set with `supabase secrets set NAME=value`, or for
# local development in supabase/functions/.env, which is git-ignored):
#   SHOPIFY_SHOP_DOMAIN      your-store.myshopify.com
#   SHOPIFY_CLIENT_ID        the app's client ID, from the Shopify Dev Dashboard
#   SHOPIFY_CLIENT_SECRET    the app's client secret; also verifies webhooks
#   SHOPIFY_API_VERSION      optional, defaults to 2026-10
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided to Edge Functions
# by the platform.
#
# Admin server (M4):
#   SUPABASE_SERVICE_ROLE_KEY

# Local database used by `make db-test` (plain PostgreSQL, not Supabase).
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
