{
  "name": "bro-batch",
  "private": true,
  "description": "Bro Batch POS, Rewards and Admin platform",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "build": "pnpm -r run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:functions": "deno test --config supabase/functions/deno.json --no-lock --allow-env=BROBATCH_TEST_DB --allow-run=psql supabase/functions/tests",
    "check:functions": "deno check --config supabase/functions/deno.json --no-lock supabase/functions/*/index.ts supabase/functions/tests/*.ts"
  },
  "devDependencies": {
    "deno": "^2.9.6",
    "prettier": "^3.10.0",
    "supabase": "^3.1.0"
  }
}
